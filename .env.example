# IEC Assignment 1 - Two Provider Cost Tracker configuration.
# Copy this file to .env and replace the placeholder values with your own.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

# --- Google Gemini (Google AI Studio) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Free-tier text model. Default below has a verified rate in tracker.py.
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (GroqCloud) ---
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Developer/free-plan model. Default below has a verified rate in tracker.py.
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional price overrides (USD per 1 million tokens) ---
# Only needed for a model that is not in the PRICING table in tracker.py.
# If you set these, both input and output prices must be provided.
# GEMINI_INPUT_PRICE_PER_M=
# GEMINI_OUTPUT_PRICE_PER_M=
# GROQ_INPUT_PRICE_PER_M=
# GROQ_OUTPUT_PRICE_PER_M=
